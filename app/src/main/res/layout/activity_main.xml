<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto Refresh"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: STOPPED"
        android:textSize="20sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/intervalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Interval: 60s"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/intervalSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="300"
        android:progress="60"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Enable Accessibility"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Start"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restart X"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/restartIntervalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restart every: 30 min"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/restartIntervalSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="120"
        android:progress="30"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnRestartX"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restart X Now"
        android:layout_marginBottom="4dp" />

    <CheckBox
        android:id="@+id/chkAutoRestart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto restart X"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scripts"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/chkMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="twitter_monitor.sh"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/chkUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="upload.sh"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/scriptStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Console:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/consoleScroll"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#1a1a1a"
        android:padding="8dp">

        <TextView
            android:id="@+id/consoleOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#00ff00"
            android:fontFamily="monospace"
            android:typeface="monospace" />
    </ScrollView>

    <Button
        android:id="@+id/btnClearLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear Log"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open X app, then press Start"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:textColor="#666666" />

</LinearLayout>
</ScrollView>
